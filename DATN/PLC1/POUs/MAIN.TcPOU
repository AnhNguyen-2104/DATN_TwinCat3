<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <POU Name="MAIN" Id="{1dc1cc65-9e37-4e46-ab96-71432f29bc06}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
    // ================================================================
    // 1. KẾT NỐI TCP VỚI CPU MITSUBISHI Q06UDEH (CỔNG 5010)
    // ================================================================
    stMelsec            : ST_MelsecSession; // Session TCP dùng chung
    fbMelsecConfig      : FB_MelsecTcpConfig;

    bTcpEnable          : BOOL := TRUE;     // Tự động kết nối và duy trì kết nối mạng
    sPlcQ_IP            : STRING(15) := '192.168.3.39'; // IP của PLC-Q
    nPlcQ_Port          : UDINT := 5010;   // Cổng Port MC Protocol 5010

    bPlcQConnected      : BOOL;             // ĐÈN BÁO: TRUE = Đã thông mạng với PLC-Q
    bPlcQError          : BOOL;
    nPlcQErrorID        : UDINT;

    // ================================================================
    // 2. TEST TRUYỀN THÔNG THỦ CÔNG SANG PLC-Q (KHI bStartGlueCycle = FALSE)
    // ================================================================
    bTest_WriteD100     : BOOL := FALSE;    // Click đúp TRUE -> Ghi nTest_D100_Val vào D100-D101
    nTest_D100_Val      : DINT := 100;      // Số 32-bit gửi thử sang D100
    bTest_WriteM1000    : BOOL := FALSE;    // Click đúp TRUE -> Ghi bit M1000
    bTest_M1000_Val     : BOOL := TRUE;     // Giá trị bit M1000 muốn ghi (TRUE=ON, FALSE=OFF)
    bTest_ReadM1001     : BOOL := FALSE;    // Click đúp TRUE -> Đọc bit M1001 từ PLC-Q
    bTest_M1001_Result  : BOOL;             // Giá trị M1001 đọc được từ PLC-Q

    // ================================================================
    // 3. ENCODER BĂNG TẢI: ST-5114 MODULE 12
    // ================================================================
    fbConveyor          : FB_ConveyorEncoder;

    nEncoderPulse       : UINT;            // Số xung Encoder hiện tại
    nEncoderDelta       : INT;             // Xung thay đổi trong 10 ms
    rConveyorSpeed      : LREAL;           // Vận tốc băng tải lọc mượt, mm/s
    rConveyorSpeedMPM   : LREAL;           // Vận tốc băng tải, m/phút
    rConveyorDist       : LREAL;           // Tổng quãng đường băng tải, mm

    // ================================================================
    // 4. EZI-SERVO: TRỤC QUAY ĐƠN VỊ DEGREE
    // ================================================================
    Axis1               : AXIS_REF;

    fbServo             : FB_EziServoControl;

    bServo_Enable       : BOOL := TRUE;     // TRUE = Servo ON / giữ cốt
    bServo_Reset        : BOOL := FALSE;    // TRUE một chu kỳ = Reset Alarm
    bServo_JogFwd       : BOOL := FALSE;    // TRUE = chạy thuận
    bServo_JogBwd       : BOOL := FALSE;    // TRUE = chạy nghịch

    rServo_Speed        : LREAL := 100.0;   // Degree/s
    rServo_Acc          : LREAL := 400.0;   // Degree/s2
    rServo_Dec          : LREAL := 400.0;   // Degree/s2

    bServo_Ready        : BOOL;             // TRUE = Servo ON
    rServo_ActPos_Deg   : LREAL;            // Góc thực tế, Degree
    rServo_ActVel_Deg_s : LREAL;            // Vận tốc thực tế, Degree/s

    // ================================================================
    // 5. TRACKING 4 ĐIỂM: CAMERA + ENCODER
    // ================================================================
    fbTracking4Pt       : FB_ConveyorTracking4Pt;

    bSystemReset        : BOOL := FALSE;    // TRUE một chu kỳ: reset mốc phần mềm về 0
    // Camera giả lập test
    bCameraTrigger      : BOOL := FALSE;    // FALSE -> TRUE: chốt sản phẩm mới
    rCameraCenterX      : LREAL := 50.0;    // Tâm phôi X, mm
    rCameraCenterY      : LREAL := 85.0;    // Tâm phôi Y, mm
    rCameraAngleDeg     : LREAL := 0.0;     // Góc phôi, Degree
    rProductLength      : LREAL := 40.0;    // mm
    rProductWidth       : LREAL := 40.0;    // mm

    // Kết quả debug Tracking
    bProductValid       : BOOL;
    nPulseAtCamera      : UINT;
    nPulseTravel        : INT;
    rPartTravel_mm      : LREAL;

    aCornerBase         : ARRAY[1..4] OF ST_Point2D;
    aCornerNow          : ARRAY[1..4] OF ST_Point2D;

    // ================================================================
    // 6. QD75 COMMAND PUBLISHER: ĐIỀU PHỐI 4 ĐỈNH SANG PLC-Q
    // ================================================================
    fbPublisher         : FB_QD75CommandPublisher;

    // Lệnh chu trình chấm keo
    bStartGlueCycle     : BOOL := FALSE;   // FALSE -> TRUE: kích chạy chu trình 4 đỉnh
    bAbortGlueCycle     : BOOL := FALSE;   // TRUE: dừng khẩn cấp (ghi M105)

    // Trạng thái giám sát chu trình
    bGlueCycleBusy      : BOOL;            // Đang chạy 4 đỉnh
    bGlueCycleDone      : BOOL;            // Hoàn tất cả 4 đỉnh
    bGlueCycleError     : BOOL;            // Báo lỗi
    nGlueCurVertex      : INT;             // Đỉnh đang thực hiện (1..4)
    nGlueErrorCode      : INT;             // Mã lỗi (501..503, 900..921)
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ================================================================
// 1. TCP CONFIG: Kết nối / tự reconnect đến PLC-Q
// ================================================================
fbMelsecConfig(
    bEnable     := bTcpEnable,
    sRemoteHost := sPlcQ_IP,
    nRemotePort := nPlcQ_Port,
    stSession   := stMelsec
);

// Biến trạng thái đưa ra ngoài để Online debug dễ
bPlcQConnected := stMelsec.bConnected;
bPlcQError     := stMelsec.bError;
nPlcQErrorID   := stMelsec.nErrorID;


// ================================================================
// 2. ENCODER BĂNG TẢI: ST-5114 INPUT BYTE 0 + BYTE 1
// ================================================================
fbConveyor(
    bByte0          := GVL.aIn[0],
    bByte1          := GVL.aIn[1],
    rK_mm           := 0.476475,
    rCycleTime      := 0.01,

    nRawPulse       => nEncoderPulse,
    nDeltaPulse     => nEncoderDelta,
    rSpeed_mm_s     => rConveyorSpeed,
    rSpeed_m_min    => rConveyorSpeedMPM,
    rTotalDist_mm   => rConveyorDist
);


// ================================================================
// 3. EZI-SERVO: ENABLE, RESET, JOG VÀ GIÁM SÁT
// ================================================================
fbServo(
    Axis            := Axis1,
    bEnable         := bServo_Enable,
    bResetFault     := bServo_Reset,
    bJogFwd         := bServo_JogFwd,
    bJogBwd         := bServo_JogBwd,
    rTargetVelocity := rServo_Speed,
    rAcc            := rServo_Acc,
    rDec            := rServo_Dec,

    bReady          => bServo_Ready,
    rActPos_Deg     => rServo_ActPos_Deg,
    rActVel_Deg     => rServo_ActVel_Deg_s
);

IF bServo_Reset THEN
    bServo_Reset := FALSE;
END_IF;


// ================================================================
// 4. TRACKING 4 ĐIỂM: CAMERA + ENCODER
// ================================================================
fbTracking4Pt(
    bResetSystem   := bSystemReset,
    bCameraResult  := bCameraTrigger,
    rCenterX_mm    := rCameraCenterX,
    rCenterY_mm    := rCameraCenterY,
    rAngleDeg      := rCameraAngleDeg,
    rLength_mm     := rProductLength,
    rWidth_mm      := rProductWidth,

    nEncoderNow    := nEncoderPulse,
    rMmPerPulse    := 0.476475,
    rXMaxLimit_mm  := 180.0,

    bProductValid  => bProductValid,
    nPulseAtCamera => nPulseAtCamera,
    nPulseTravel   => nPulseTravel,
    rTravel_mm     => rPartTravel_mm,
    aCornerBase    => aCornerBase,
    aCornerNow     => aCornerNow
);

IF bSystemReset THEN
    bSystemReset := FALSE;
END_IF;


// ================================================================
// 5. QD75 COMMAND PUBLISHER: ĐIỀU PHỐI 4 ĐỈNH & TEST THỦ CÔNG
// ================================================================
fbPublisher(
    stSession           := stMelsec,
    bStartCycle         := bStartGlueCycle,
    bAbortCycle         := bAbortGlueCycle,

    // Tọa độ 4 góc thời gian thực từ khối Tracking
    aCornerNow          := aCornerNow,
    rConveyorSpeed_mm_s := rConveyorSpeed,

    // Động học
    rFlyTime_s          := 0.120,
    rApproachSpeed_mm_s := 500.0,
    rSyncTime_s         := 0.060,
    rZDown_mm           := 4.0,
    rZSafe_mm           := 0.0,

    // Chế độ test thủ công (chỉ có tác dụng khi bStartGlueCycle = FALSE)
    bManualWriteD100    := bTest_WriteD100,
    nD100_ManualVal     := nTest_D100_Val,
    bManualWriteM1000   := bTest_WriteM1000,
    bM1000_ManualVal    := bTest_M1000_Val,
    bManualReadM1001    := bTest_ReadM1001,

    // Giám sát
    bBusy               => bGlueCycleBusy,
    bDone               => bGlueCycleDone,
    bError              => bGlueCycleError,
    nErrorCode          => nGlueErrorCode,
    nCurrentVertex      => nGlueCurVertex,
    bM1001_ReadBack     => bTest_M1001_Result
);

// Tự động nhả cờ kích test sau khi lệnh được nhận
IF bTest_WriteD100 AND NOT fbPublisher.bManualWriteD100 THEN
    bTest_WriteD100 := FALSE;
END_IF;

IF bTest_WriteM1000 AND NOT fbPublisher.bManualWriteM1000 THEN
    bTest_WriteM1000 := FALSE;
END_IF;

IF bTest_ReadM1001 AND NOT fbPublisher.bManualReadM1001 THEN
    bTest_ReadM1001 := FALSE;
END_IF;
]]></ST>
    </Implementation>
    <LineIds Name="MAIN">
      <LineId Id="2227" Count="66" />
      <LineId Id="1352" Count="0" />
      <LineId Id="2316" Count="21" />
      <LineId Id="2315" Count="0" />
      <LineId Id="2361" Count="20" />
      <LineId Id="2360" Count="0" />
      <LineId Id="2493" Count="26" />
    </LineIds>
  </POU>
</TcPlcObject>
