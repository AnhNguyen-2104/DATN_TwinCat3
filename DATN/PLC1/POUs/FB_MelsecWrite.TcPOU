<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <POU Name="FB_MelsecWrite" Id="{cd46833e-fdfc-41d5-b322-0b15174aac26}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_MelsecWrite
VAR_INPUT
    bExecute        : BOOL;             // Cạnh lên bắt đầu ghi
    eDevice         : E_MelsecDevice;   // DEV_D, DEV_M, DEV_W, DEV_R, DEV_ZR...
    nStartAddr      : UDINT;            // Địa chỉ đầu: 100 = D100 hoặc M100
    nPoints         : UINT;             // Word hoặc Bit cần ghi
    bBitAccess      : BOOL := FALSE;    // FALSE = Word/DWord; TRUE = Bit
    pData           : PVOID;            // ADR(vùng dữ liệu cần gửi)
    nDataSize       : UDINT;            // SIZEOF(vùng dữ liệu cần gửi)
END_VAR

VAR_IN_OUT
    stSession       : ST_MelsecSession; // TCP socket dùng chung
END_VAR

VAR_OUTPUT
    bDone           : BOOL;             // Ghi thành công
    bBusy           : BOOL;             // Đang giao dịch
    bError          : BOOL;             // Lỗi giao dịch
    nErrorID        : UDINT;            // Socket error hoặc MC Protocol End Code
END_VAR

VAR
    fbTrigger       : R_TRIG;
    fbSend          : FB_SocketSend;
    fbReceive       : FB_SocketReceive;
    tonTimeout      : TON;

    nState          : INT := 0;
    aTx             : ARRAY[0..2047] OF BYTE;
    aRx             : ARRAY[0..2047] OF BYTE;

    nDataBytes      : UINT;
    nRequestLength  : UINT;
    nSendLength     : UDINT;
    nEndCode        : UINT;

    pByteData       : POINTER TO BYTE;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[fbTrigger(CLK := bExecute);

// Giá trị Done/Error chỉ tồn tại một chu kỳ sau khi giao dịch kết thúc
IF nState = 0 THEN
    bDone  := FALSE;
    bError := FALSE;
END_IF;



CASE nState OF

    0: // Chờ cạnh lên bExecute
        bBusy := FALSE;
        stSession.bBusy := FALSE;

        IF fbTrigger.Q THEN
            // Chỉ gửi khi TCP đã kết nối và chưa có giao dịch khác
            IF NOT stSession.bConnected THEN
                bError   := TRUE;
                nErrorID := 16#E001; // TCP chưa kết nối
            ELSIF stSession.bBusy THEN
                bError   := TRUE;
                nErrorID := 16#E002; // Socket đang bị FB khác dùng
            ELSIF (pData = 0) OR (nPoints = 0) THEN
                bError   := TRUE;
                nErrorID := 16#E003; // Con trỏ hoặc số lượng không hợp lệ
            ELSE
                // ----------------------------------------------------
                // Header MC Protocol 3E Binary
                // ----------------------------------------------------
                aTx[0]  := 16#50; aTx[1]  := 16#00; // Request subheader
                aTx[2]  := 16#00;                   // Network number
                aTx[3]  := 16#FF;                   // PC number
                aTx[4]  := 16#FF; aTx[5] := 16#03; // CPU module I/O No 03FF
                aTx[6]  := 16#00;                   // Station number
                aTx[9]  := 16#10; aTx[10] := 16#00; // Monitoring timer

                // Command = 1401h: Batch Write
                aTx[11] := 16#01;
                aTx[12] := 16#14;

                // Subcommand: 0000h=Word, 0001h=Bit
                IF bBitAccess THEN
                    aTx[13] := 16#01;
                    aTx[14] := 16#00;
                ELSE
                    aTx[13] := 16#00;
                    aTx[14] := 16#00;
                END_IF;

                // Start address: 3 bytes little-endian
                aTx[15] := UDINT_TO_BYTE(nStartAddr AND 16#FF);
                aTx[16] := UDINT_TO_BYTE(SHR(nStartAddr, 8) AND 16#FF);
                aTx[17] := UDINT_TO_BYTE(SHR(nStartAddr, 16) AND 16#FF);

                // Mitsubishi device code
                aTx[18] := TO_BYTE(eDevice);

                // Số Word hoặc Bit
                aTx[19] := UINT_TO_BYTE(nPoints AND 16#FF);
                aTx[20] := UINT_TO_BYTE(SHR(nPoints, 8) AND 16#FF);

                // ----------------------------------------------------
                // Copy dữ liệu cần ghi
                // ----------------------------------------------------
                IF bBitAccess THEN
                    // MC Binary bit data đóng 2 bit trên 1 byte
                    // Trường hợp dùng 1 bit: FALSE = 00h, TRUE = 10h.
                    IF nPoints = 1 THEN
                        pByteData := pData;

                        IF pByteData^ = 0 THEN
                            aTx[21] := 16#00;
                        ELSE
                            aTx[21] := 16#10;
                        END_IF;

                        nDataBytes := 1;
                    ELSE
                        nDataBytes := (nPoints + 1) / 2;

                        IF nDataBytes > nDataSize THEN
                            bError   := TRUE;
                            nErrorID := 16#E004; // Buffer bit quá nhỏ
                            RETURN;
                        END_IF;

                        MEMCPY(ADR(aTx[21]), pData, nDataBytes);
                    END_IF;
                ELSE
                    // Word access: 1 word = 2 byte
                    nDataBytes := nPoints * 2;

                    IF nDataBytes > nDataSize THEN
                        bError   := TRUE;
                        nErrorID := 16#E005; // Buffer word quá nhỏ
                        RETURN;
                    END_IF;

                    MEMCPY(ADR(aTx[21]), pData, nDataBytes);
                END_IF;

                // Request length = timer + command + subcommand +
                //                  device + points + data
                nRequestLength := 12 + nDataBytes;
                aTx[7] := UINT_TO_BYTE(nRequestLength AND 16#FF);
                aTx[8] := UINT_TO_BYTE(SHR(nRequestLength, 8) AND 16#FF);

                nSendLength := 9 + nRequestLength;
                bBusy  := TRUE;
                stSession.bBusy := TRUE;
                nState := 10;
            END_IF;
        END_IF;


    10: // Phát lệnh Socket Send bằng cạnh lên
        fbSend(
            sSrvNetId := '',
            hSocket   := stSession.hSocket,
            cbLen     := nSendLength,
            pSrc      := ADR(aTx),
            bExecute  := TRUE,
            tTimeout  := T#3S
        );

        nState := 11;


    11: // Chờ gửi xong
        fbSend(
            sSrvNetId := '',
            hSocket   := stSession.hSocket,
            cbLen     := nSendLength,
            pSrc      := ADR(aTx),
            bExecute  := FALSE,
            tTimeout  := T#3S
        );

        IF NOT fbSend.bBusy THEN
            IF fbSend.bError THEN
                bError   := TRUE;
                nErrorID := fbSend.nErrId;
                bBusy    := FALSE;
                nState   := 0;
            ELSE
                tonTimeout(IN := TRUE, PT := T#2S);
                nState := 20;
            END_IF;
        END_IF;


    20: // Phát lệnh nhận phản hồi PLC
        fbReceive(
            sSrvNetId := '',
            hSocket   := stSession.hSocket,
            cbLen     := SIZEOF(aRx),
            pDest     := ADR(aRx),
            bExecute  := TRUE,
            tTimeout  := T#3S
        );

        nState := 21;


    21: // Chờ nhận phản hồi
        fbReceive(
            sSrvNetId := '',
            hSocket   := stSession.hSocket,
            cbLen     := SIZEOF(aRx),
            pDest     := ADR(aRx),
            bExecute  := FALSE,
            tTimeout  := T#3S
        );

        IF NOT fbReceive.bBusy THEN
            tonTimeout(IN := FALSE);

            IF fbReceive.bError THEN
                bError   := TRUE;
                nErrorID := fbReceive.nErrId;

            ELSIF fbReceive.nRecBytes < 11 THEN
                bError   := TRUE;
                nErrorID := 16#E006; // Frame phản hồi quá ngắn

            ELSIF (aRx[0] <> 16#D0) OR (aRx[1] <> 16#00) THEN
                bError   := TRUE;
                nErrorID := 16#E007; // Sai response subheader

            ELSE
                // End code tại byte 9..10
                nEndCode := BYTE_TO_UINT(aRx[9]) +
                             BYTE_TO_UINT(aRx[10]) * 256;

                IF nEndCode = 0 THEN
                    bDone := TRUE;
                ELSE
                    bError   := TRUE;
                    nErrorID := nEndCode; // Mã lỗi Mitsubishi
                END_IF;
            END_IF;

            bBusy  := FALSE;
            nState := 0;
        END_IF;

        IF tonTimeout.Q THEN
            tonTimeout(IN := FALSE);
            bError   := TRUE;
            nErrorID := 16#E008; // PLC không phản hồi trong 2 giây
            bBusy    := FALSE;
            nState   := 0;
        END_IF;

END_CASE;

// Cập nhật session cho FB Read / Write khác dùng chung
stSession.bBusy    := bBusy;
stSession.bError   := bError;
stSession.nErrorID := nErrorID;]]></ST>
    </Implementation>
    <LineIds Name="FB_MelsecWrite">
      <LineId Id="48" Count="220" />
      <LineId Id="9" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>